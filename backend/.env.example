DB_HOST=localhost
DB_PORT=3306
DB_NAME=vision_assistant
DB_USER=root
DB_PASSWORD=your_password

# Hugging Face access token with permission to call Inference Providers.
HF_TOKEN=

# Default candidate from the EyeSight VLM comparison plan.
# Override with the selected model or a model deployed on a custom endpoint.
VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# Optional dedicated Hugging Face Inference Endpoint URL.
# Use this for a separately deployed candidate such as SmolVLM2.
HF_INFERENCE_ENDPOINT_URL=
