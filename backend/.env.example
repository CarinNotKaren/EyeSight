DB_HOST=localhost
DB_PORT=3306
DB_NAME=vision_assistant
DB_USER=root
DB_PASSWORD=your_password



JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=


# Gemini API credentials (never expose this key in the frontend).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Vision-language model used for image-question answering.
VLM_MODEL=gemini-3.5-flash-lite

# Local Whisper speech-to-text model: compare "base" and "small".
WHISPER_MODEL=base

# Use CPU by default for compatibility with team laptops.
WHISPER_DEVICE=cpu
