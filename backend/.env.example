DB_HOST=localhost
DB_PORT=3306
DB_NAME=vision_assistant
DB_USER=root
DB_PASSWORD=your_password



JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=


# Gemini API credentials (never expose this key in the frontend).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Cloud vision-language model.
VLM_MODEL=gemini-2.5-flash-lite

# Local Whisper speech-to-text model: compare "base" and "small".
WHISPER_MODEL=base

# Use CPU by default for compatibility with team laptops.
WHISPER_DEVICE=cpu

# WebRTC ICE configuration. STUN assists NAT discovery; TURN relays media when direct paths fail.
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_MAX_ACTIVE_STREAMS=8
WEBRTC_FRAME_SAMPLE_INTERVAL_SECONDS=1.0
WEBRTC_MAX_FRAME_WIDTH=1280
WEBRTC_JPEG_QUALITY=85
WEBRTC_MAX_SIGNAL_MESSAGE_BYTES=65536
WEBRTC_OFFER_TIMEOUT_SECONDS=20

# Maximum age of retained camera frames and session history (seconds).
SESSION_FRAME_RETENTION_SECONDS=86400
